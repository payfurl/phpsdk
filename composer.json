{
    "name": "payfurl/phpsdk",
    "description": "The payFURL API for PHP: charges, customers, payment methods, subscriptions and the rest of the public REST API",
    "type": "library",
    "license": "MIT",
    "keywords": ["payfurl", "payments", "payment orchestration", "sdk"],
    "homepage": "https://github.com/payfurl/phpsdk",
    "support": {
        "docs": "https://docs.payfurl.com",
        "issues": "https://github.com/payfurl/phpsdk/issues",
        "source": "https://github.com/payfurl/phpsdk"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "payFURL\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "payFURL\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
